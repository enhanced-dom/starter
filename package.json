{
  "name": "@enhanced-dom/starter",
  "version": "0.1.1",
  "description": "Helpers for jumpstarting a project",
  "repository": "https://github.com/enhanced-dom/starter.git",
  "type": "module",
  "main": "index.js",
  "bin": {
    "@enhanced-dom-starter": "./index.js"
  },
  "scripts": {
    "configure-claude": "@enhanced-dom-claude --configs react code agent rtk devcontainer caveman-lite",
    "configure-lint": "@enhanced-dom-fallow --gitignore --entry 'test/**/*.test.ts' --ignoreDependencies @enhanced-dom/babel @enhanced-dom/webpack @enhanced-dom/react @enhanced-dom/webcomponent && @enhanced-dom-npmrc --gitignore && @enhanced-dom-nvmrc --gitignore && @enhanced-dom-husky --gitignore",
    "configure-build": "@enhanced-dom-bootstrap-tsconfig --type=node",
    "prepare": "npm run configure-lint && npm run configure-claude && npm run configure-build",
    "package": "cd dist && npm pack",
    "prebuild": "rimraf dist/*",
    "build": "tsc -p ./tsconfig.json",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "postbuild": "tsc-esm-fix --tsconfig=./tsconfig.json && copyfiles LICENSE.md README.md dist && @enhanced-dom-copy-packagejson",
    "lint": "eslint --fix --config eslint.config.mjs src test",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest --config test/jest.config.mjs"
  },
  "keywords": [],
  "author": "CD9B4A105290E17E0948E021DF4105107C88693C59C0B891CCC08366C51AEA990902A6A156AC87D88A2FC41422A5E1C3C4071F251F19441C4516000EC25F87DF",
  "license": "MIT",
  "dependencies": {
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@enhanced-dom/babel": "^0.3.0",
    "@enhanced-dom/build": "^0.3.4",
    "@enhanced-dom/claude": "^0.3.2",
    "@enhanced-dom/jest": "^0.3.0",
    "@enhanced-dom/lint": "^0.4.3",
    "@enhanced-dom/react": "^0.4.0",
    "@enhanced-dom/webcomponent": "^0.5.0",
    "@enhanced-dom/webpack": "^0.5.3",
    "@jest/globals": "^30.5.2",
    "@types/node": "^22.20.5",
    "@types/yargs": "^17.0.35"
  },
  "engines": {
    "node": ">=22.23.2",
    "npm": ">=12"
  }
}
